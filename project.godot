; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes to the same file as [section] in ProjectSettings.get_setting()
;
; Godot 4 project file for Destination of Power.

config_version=5

[application]

config/name="Destination of Power"
config/description="A top-down 2D roguelike adventure set in the world of Nerax - MVP build."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/autoload/EventBus.gd"
SaveManager="*res://scripts/autoload/SaveManager.gd"
AbilityRegistry="*res://scripts/autoload/AbilityRegistry.gd"
ClassRegistry="*res://scripts/autoload/ClassRegistry.gd"
ItemRegistry="*res://scripts/autoload/ItemRegistry.gd"
ArtifactRegistry="*res://scripts/autoload/ArtifactRegistry.gd"
EnemyRegistry="*res://scripts/autoload/EnemyRegistry.gd"
AllyRegistry="*res://scripts/autoload/AllyRegistry.gd"
EncounterRegistry="*res://scripts/autoload/EncounterRegistry.gd"
AppearanceRegistry="*res://scripts/autoload/AppearanceRegistry.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
ArtifactSystem="*res://scripts/autoload/ArtifactSystem.gd"
RunManager="*res://scripts/autoload/RunManager.gd"
SceneManager="*res://scripts/autoload/SceneManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

