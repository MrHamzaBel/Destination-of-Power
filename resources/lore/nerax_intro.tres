[gd_resource type="Resource" script_class="LoreScript" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/LoreScript.gd" id="1_lore"]

[resource]
script = ExtResource("1_lore")
sections = Array[String](["The world of Nerax has always been a place where survival of the strongest was enforced.", "Kingdoms still rise and fall. Factions fight for power, while corruption spreads through royal courts and forgotten streets.", "Yet love, loyalty, and hope still survive beside cruelty, ambition, and evil.", "Every warrior, criminal, ruler, and wanderer must choose their own path.", "In this world, where will you lead yourself?"])
