[node name="GuildScoutElinInteract" type="Area2D" parent="."]
collision_layer = 2
collision_mask = 0
position = Vector2(-220, 130)
script = ExtResource("6_interactable")
display_name = "Guild Scout Elin"
kind = 6
dialogue_prompt = "\"You look capable,\" a woman in guild colors says, studying a hand-drawn map. \"I'm Elin - I scout leads for the guild. Word's reached us of a sealed cavern far south, past the outskirts. I need someone to find it and report back before we risk a real expedition. Interested?\""
dialogue_yes_text = "\"Good. Head south past the lake and the old tree, then keep going - there's a path that hasn't been mapped yet. Report back once you've seen it.\""
dialogue_no_text = "\"Fair enough. It'll still be there if you change your mind.\""
dialogue_decline_text = "\"No harm in asking,\" she says, and goes back to her map."
dialogue_quest_active_text = "\"Any sign of that cavern yet?\" Elin asks, watching the southern road."
quest_id = "into_the_hollow"

[node name="Shape" type="CollisionShape2D" parent="GuildScoutElinInteract"]
shape = SubResource("InteractShape")

[node name="GuildScoutElinVisual" type="Polygon2D" parent="GuildScoutElinInteract"]
