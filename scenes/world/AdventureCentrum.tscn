[node name="JuniorClerkInteract" type="Area2D" parent="."]
collision_layer = 2
collision_mask = 0
position = Vector2(-60, -150)
script = ExtResource("6_interactable")
display_name = "Junior Clerk"
kind = 6
dialogue_prompt = "\"Oh - are you here about the rat problem?\" the junior clerk asks, barely looking up from his ledger. \"They keep getting into the stores behind the alley. Six of them, and there's a few coins in it for whoever deals with it.\""
dialogue_yes_text = "\"Much appreciated,\" he says, already back to his ledger."
dialogue_no_text = "\"Suit yourself. They'll still be there later.\""
dialogue_decline_text = "He shrugs and goes back to his paperwork."
dialogue_quest_active_text = "\"Still six rats too many out there,\" he mutters without looking up."
quest_id = "pest_control"

[node name="Shape" type="CollisionShape2D" parent="JuniorClerkInteract"]
shape = SubResource("InteractShape")

