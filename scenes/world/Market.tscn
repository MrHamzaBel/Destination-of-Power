[node name="GossipingResidentVisual" parent="GossipingResidentInteract" instance=ExtResource("7_enemy")]

[node name="WatchSergeantInteract" type="Area2D" parent="."]
collision_layer = 2
collision_mask = 0
position = Vector2(-100, -60)
script = ExtResource("6_interactable")
display_name = "Watch Sergeant"
kind = 6
dialogue_prompt = "\"You've got the look of someone who can handle themselves,\" the sergeant says, voice low. \"There's a killer working the Garrison Ward, west of here. Guild command's authorized a bounty - but only for adventurers we actually trust with this. You in?\""
dialogue_yes_text = "\"Good. He's fast and he won't announce himself. Watch your back.\""
dialogue_no_text = "\"Your call. Offer stands if you change your mind.\""
dialogue_decline_text = "\"Fair enough,\" he says, and goes back to watching the street."
dialogue_quest_active_text = "\"Any sign of him yet?\" the sergeant asks, scanning the rooftops."
quest_id = "blade_in_the_dark"
required_guild_rank_order = 2
locked_message = "\"This one's above your rank,\" the sergeant says, not unkindly. \"Come back once you've made D-Rank.\""

