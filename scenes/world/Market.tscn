[node name="GossipingResidentInteract" type="Area2D" parent="."]
collision_layer = 2
collision_mask = 0
position = Vector2(-70, 30)
script = ExtResource("6_interactable")
display_name = "Local Resident"
kind = 0
message = "\"Did you hear? Guards've been talking about strange lights past the old tree, and something about a sealed cave even further south. Adventurers, I swear - can't leave well enough alone.\""

[node name="Shape" type="CollisionShape2D" parent="GossipingResidentInteract"]
