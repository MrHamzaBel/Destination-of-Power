[node name="InformantInteract" type="Area2D" parent="."]
collision_layer = 2
collision_mask = 0
position = Vector2(0, -140)
script = ExtResource("6_interactable")
display_name = "Frightened Merchant"
kind = 6
dialogue_prompt = "\"Guild colors!\" A trembling merchant peers out from behind a crate. \"Thank the Crown - listen, the one who leads these thugs, the big one in the back... the guild's had a bounty on him for MONTHS. Nobody's collected. Will you end this?\""
dialogue_yes_text = "\"Please,\" he whispers. \"Just... be careful.\""
dialogue_no_text = "\"I understand,\" he says, shrinking back behind the crate."
dialogue_decline_text = "He nods and says nothing more, watching the shadows."
dialogue_quest_active_text = "\"Have you dealt with him yet?\" the merchant whispers, still hiding."
quest_id = "guild_grudge"
required_guild_rank_order = 1
locked_message = "\"You don't look guild-ranked enough for this,\" he says nervously. \"I need someone the guild actually trusts.\""

