[node name="AdventurerInteract" type="Area2D" parent="."]
collision_layer = 2
collision_mask = 0
position = Vector2(0, 190)
script = ExtResource("6_interactable")
display_name = "Traveling Adventurer"
kind = 6
dialogue_prompt = "\"You look like you can handle yourself out there,\" the traveler says, eyeing your gear. \"Are you an adventurer?\""
dialogue_yes_text = "\"Perfect - then maybe you can help. My brother Wassim headed to the Adventure Centrum to submit a bounty and never came back. That's where most quests and missions get posted. Could you check on him?\" You agree to look into it."
dialogue_no_text = "\"Not yet? You should think about it,\" he says. \"Registered adventurers get bigger cuts on missions and quests - and the recognition doesn't hurt either.\""
dialogue_decline_text = "\"Fair enough,\" he says, raising his hands. \"None of my business. Apologies for prying.\""
dialogue_quest_active_text = "\"Any word on Wassim? Last I heard he tried to sneak into the Adventurers' Guild lounge without the proper rank and made a scene. They're holding him there - you'd need to be C-Rank or higher to get in and sort it out.\""
dialogue_quest_done_text = "\"Thank you again,\" he says, relief plain on his face. \"I still say my brother did nothing wrong - I'm going to speak with the guards myself.\""
quest_id = "find_wassim"

